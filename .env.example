# ─────────────────────────────────────────────────────────────
# Picklr credentials
# ─────────────────────────────────────────────────────────────

# Your Picklr login email + password (fremont.thepicklr.com/users/sign_in)
PICKLR_EMAIL=your-email@example.com
PICKLR_PASSWORD=your-password

# Base URL for your Picklr location (change the subdomain if not Fremont)
PICKLR_BASE_URL=https://fremont.thepicklr.com

# Physical venue address used as the calendar event location
PICKLR_VENUE_ADDRESS=124 N 35th St, Seattle, WA 98103

# ─────────────────────────────────────────────────────────────
# Google Calendar
# ─────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client (Desktop app) in Google Cloud Console,
# enable the Google Calendar API, then run `pnpm auth:google` to mint
# a refresh token. Paste all three values below.

GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REFRESH_TOKEN=xxxxxxxx

# Target calendar. "primary" is your default calendar, or paste a
# specific calendar ID (…@group.calendar.google.com) to keep bookings
# in a dedicated calendar.
GOOGLE_CALENDAR_ID=primary

# ─────────────────────────────────────────────────────────────
# Notifications (Resend)
# ─────────────────────────────────────────────────────────────

RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_EMAIL=your-email@example.com

# ─────────────────────────────────────────────────────────────
# Behavior
# ─────────────────────────────────────────────────────────────

# Timezone used to render event times (IANA tz name)
TIMEZONE=America/Los_Angeles

# Only sync bookings within this many days ahead (0 = no limit)
DAYS_AHEAD=30

# Dry run: crawl + compute the diff but do NOT touch the calendar or
# send email. Prints the plan to stdout. Great for first local test.
DRY_RUN=false

# Run the browser headed (visible) for debugging the login flow
HEADED=false

# Send an email even when nothing changed (default: false = stay quiet)
NOTIFY_ON_NO_CHANGES=false
