{
  "name": "picklr-sync",
  "version": "1.0.0",
  "description": "Crawl Picklr bookings and sync them to Google Calendar, with email status via Resend",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "sync": "tsx src/main.ts",
    "sync:headed": "HEADED=true tsx src/main.ts",
    "sync:dry": "DRY_RUN=true tsx src/main.ts",
    "auth:google": "tsx src/scripts/google-auth.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "googleapis": "^144.0.0",
    "playwright": "^1.52.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "resend": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
